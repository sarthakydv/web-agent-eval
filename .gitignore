# Secrets. Never tracked — init.sh fails the run if one ever is.
.env

# Environment and caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Run artifacts. Traces and results are large and regenerable; the numbers that
# matter get written into docs/DECISIONS.md, not left here.
runs/

# tiktoken's BPE file, fetched once on first use. Regenerable, ~1.7 MB, and not
# something to vendor. `fixtures/` is the opposite case and IS tracked: those
# captures are evidence and cannot be regenerated identically.
.cache/

.DS_Store
